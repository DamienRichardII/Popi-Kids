# Aucun secret ici. Copier en .env.local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Bouton mode nuit / mode jour (visible par défaut ; mettre false pour le masquer)
NEXT_PUBLIC_THEME_SWITCHER=true
# Fournisseur de données commerciales : "demo" tant que le moteur n'est pas validé
COMMERCE_PROVIDER=demo
